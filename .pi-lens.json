{
  "ignore": [
    "server/webui/static/index.html"
  ],
  "format": { "enabled": false },
  "autofix": { "enabled": false },
  "actionableWarnings": { "autoFix": { "enabled": false } },
  "rules": {
    "sql-convention": {
      "disable": [
        "python-sql-injection",
        "no-python-sql-string-concat",
        "S608",
        "bandit.B608",
        "sql-injection",
        "sql-injection-sink"
      ]
    }
  }
}
